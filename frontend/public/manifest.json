{
  "name": "TrackExpense - Smart Expense Tracker",
  "short_name": "TrackExpense",
  "description": "Track your incomes, expenses, borrow & lend, and financial goals effortlessly.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0d9488",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "text/plain"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Add New Expense",
      "short_name": "Add Expense",
      "description": "Log a new expense entry immediately",
      "url": "/expense?action=new",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Borrow & Lend",
      "short_name": "Borrow/Lend",
      "description": "View and manage debts and receivables",
      "url": "/borrow-lend",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
